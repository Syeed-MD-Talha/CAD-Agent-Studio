# Copy this file to .env and configure ONE provider. Never commit real keys.
# The normal editor/viewer does not need API credentials.

# Fireworks (Anthropic-compatible endpoint; leave Anthropic fields empty).
FIREWORKS_API_KEY=
FIREWORKS_MODEL_ID=accounts/fireworks/models/kimi-k2-instruct-0905
# Optional override; no /v1 suffix for this Anthropic SDK client.
FIREWORKS_BASE_URL=

# Direct Anthropic or an Anthropic-compatible gateway (takes priority).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Set a provider-supported model ID when using Anthropic or a gateway.
# The chat UI's model picker overrides this value.
MODEL_ID=

# Optional default for focused AI subagent tasks.
CQ_SUBAGENT_MODEL_ID=

# Optional fallback gateway: must implement the ANTHROPIC Messages API.
# These settings do not enable native OpenAI API support.
OPENAI_API_KEY=
OPENAI_API_BASE=
