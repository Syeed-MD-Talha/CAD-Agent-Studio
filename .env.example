# Copy this file to .env and configure one provider. Never commit real keys.
# You may instead enter a provider profile in AI Chat > Provider settings.
# The normal editor/viewer does not need API credentials.

# Initial provider when AI Chat has no saved selection:
# fireworks | featherless | anthropic | custom_openai | custom_anthropic
CQ_AI_PROVIDER=fireworks

# Fireworks (OpenAI-compatible Chat Completions endpoint).
FIREWORKS_API_KEY=
FIREWORKS_MODEL_ID=accounts/fireworks/models/kimi-k2-instruct-0905
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# Featherless (OpenAI-compatible Chat Completions endpoint).
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL_ID=Qwen/Qwen3-32B
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# Direct Anthropic / Claude.
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-4-6
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Other OpenAI-compatible Chat Completions providers.
OPENAI_API_KEY=
OPENAI_MODEL_ID=
OPENAI_API_BASE=

# Other Anthropic Messages-compatible providers.
CUSTOM_ANTHROPIC_API_KEY=
CUSTOM_ANTHROPIC_MODEL_ID=
CUSTOM_ANTHROPIC_BASE_URL=

# Optional default for focused AI subagent tasks.
CQ_SUBAGENT_MODEL_ID=
